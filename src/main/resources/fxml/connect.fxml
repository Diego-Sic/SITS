<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="12" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="sits.viewer.ConnectController">

    <padding><Insets bottom="40" left="40" right="40" top="40" /></padding>

    <Label style="-fx-font-size: 20; -fx-font-weight: bold;" text="V-SITS Viewer" />
   <Label text="By - Diego Sic :D" />

    <Label text="Server IP:" />
    <TextField fx:id="ipField" promptText="192.168.1.1" />

    <Label text="Port:" />
    <TextField fx:id="portField" promptText="8080" />

    <Button fx:id="connectButton" maxWidth="Infinity" onAction="#connect" text="Connect" />

    <Label fx:id="errorLabel" style="-fx-text-fill: red;" text="" />

</VBox>
