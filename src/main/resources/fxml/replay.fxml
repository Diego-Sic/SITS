<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="sits.viewer.ReplayController">

    <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>

    <Label text="Select a replay:" />
    <ListView fx:id="replayList" prefHeight="120" onMouseClicked="#onReplaySelected" />

    <Label fx:id="roundLabel" text="Round: 0" />

    <Slider fx:id="scrubBar" min="0" max="0" blockIncrement="1" disable="true" />

    <HBox spacing="8">
        <Button fx:id="stepBackButton"    text="◀ Step Back"   onAction="#stepBack"        disable="true" />
        <Button fx:id="playPauseButton"   text="Play"           onAction="#togglePlayPause" disable="true" />
        <Button fx:id="stepForwardButton" text="Step Forward ▶" onAction="#stepForward"     disable="true" />
    </HBox>

    <HBox spacing="8">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Move Log" />
            <TextArea fx:id="moveLogArea" editable="false" wrapText="true" prefHeight="180" />
        </VBox>
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Scores" />
            <TextArea fx:id="scoreArea" editable="false" wrapText="true" prefHeight="180" />
        </VBox>
    </HBox>

    <Button text="Back" onAction="#back" />

</VBox>
