<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="sits.viewer.LiveGameController">

    <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>

    <TextArea fx:id="feedArea" editable="false" wrapText="true" prefHeight="400" />

    <Button text="Back" onAction="#back" />

</VBox>
