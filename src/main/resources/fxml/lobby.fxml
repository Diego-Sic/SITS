<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="sits.viewer.LobbyController">

    <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>

    <ListView fx:id="tournamentList" prefHeight="300" />

    <HBox spacing="8">
        <Button text="Refresh" onAction="#refresh" />
        <Button fx:id="startButton" text="Start" onAction="#startSelected" disable="true" />
        <Button fx:id="watchButton" text="Watch" onAction="#watchSelected" disable="true" />
        <Button text="Replay" onAction="#openReplay" />
    </HBox>

</VBox>
